{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spearchucker667.github.io/RUP/schemas/final-report.schema.json",
  "title": "Verification Output",
  "description": "Schema for verification_agent output",
  "type": "object",
  "required": [
    "verification_results",
    "metrics",
    "recommendations"
  ],
  "properties": {
    "meta": {
      "$ref": "#/$defs/AgentMeta"
    },
    "verification_results": {
      "type": "object",
      "required": [
        "overall_status"
      ],
      "properties": {
        "overall_status": {
          "type": "string",
          "enum": [
            "passed",
            "passed_with_warnings",
            "failed"
          ]
        },
        "tests": {
          "$ref": "#/$defs/TestResults"
        },
        "lint": {
          "$ref": "#/$defs/LintResults"
        },
        "security": {
          "$ref": "#/$defs/SecurityResults"
        },
        "build": {
          "$ref": "#/$defs/BuildResults"
        },
        "type_check": {
          "$ref": "#/$defs/TypeCheckResults"
        }
      }
    },
    "metrics": {
      "$ref": "#/$defs/MetricsOutput"
    },
    "audit_trail": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AuditEntry"
      }
    },
    "recommendations": {
      "$ref": "#/$defs/Recommendations"
    },
    "final_report": {
      "type": "string"
    }
  },
  "additionalProperties": false
}