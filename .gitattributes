# Force LF line endings for all text files so SHA-256 hashes remain stable
# across macOS, Linux, and Windows checkouts.
* text=auto eol=lf

# Ensure JSON/YAML/Markdown files that participate in provenance verification
# are always checked out with LF.
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
